      "required": [
        "provider_market_and_index_match",
        "current_value_0_to_100",
        "classification_from_source",
        "source_update_date_or_time",
        "source_url_and_frame_evidence",
        "current_vs_history_distinguished"
      ],
      "reject_confusions": [
        "CNN_vs_crypto",
